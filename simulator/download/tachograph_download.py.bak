from datetime import datetime, timezone
from uuid import uuid4

from simulator.metadata.models import (
    Operation,
    OperationStatus,
    OperationType,
    SourceType,
    SyncStatus,
)
from simulator.operations.log import OperationLog
from simulator.storage.local_storage import LocalStorage
from simulator.sync.service import SyncService


class TachographDownloadService:
    """
    Servicio responsable de descargar los datos del tacógrafo,
    almacenarlos como archivo DDD y sincronizarlos con el servidor.
    """

    def __init__(
        self,
        tachograph,
        storage: LocalStorage,
        sync_service: SyncService | None = None,
        operation_log: OperationLog | None = None,
    ):
        self.tachograph = tachograph
        self.storage = storage
        self.sync_service = sync_service
        self.operation_log = operation_log

    def download(self) -> Operation:
        """
        Descarga los datos del tacógrafo.

        Flujo:

        1. Lee los datos del tacógrafo.
        2. Guarda el archivo DDD localmente.
        3. Intenta sincronizarlo con el servidor.
        4. Registra la operación de descarga.
        """

        operation_id = f"OP-{uuid4().hex}"
        timestamp = datetime.now(timezone.utc)

        tachograph_id = getattr(
            self.tachograph,
            "tachograph_id",
            None,
        )

        vehicle_id = getattr(
            self.tachograph,
            "vehicle_id",
            None,
        )

        vehicle_registration = getattr(
            self.tachograph,
            "vehicle_registration",
            None,
        )

        # --------------------------------------------------
        # DESCARGA DEL TACÓGRAFO
        # --------------------------------------------------

        try:
            data = self.tachograph.download()

        except Exception as exc:
            operation = Operation(
                operation_id=operation_id,
                operation_type=(
                    OperationType.TACHOGRAPH_DOWNLOAD
                ),
                timestamp=timestamp,
                source_type=SourceType.TACHOGRAPH,
                status=OperationStatus.FAILED,
                tachograph_id=tachograph_id,
                vehicle_id=vehicle_id,
                vehicle_registration=vehicle_registration,
                error_message=str(exc),
            )

            self._record(operation)

            return operation

        # --------------------------------------------------
        # NOMBRE DEL ARCHIVO DDD
        # --------------------------------------------------

        filename = (
            f"TACHOGRAPH_"
            f"{timestamp:%Y%m%d%H%M%S}_"
            f"{operation_id[-6:]}.DDD"
        )

        # --------------------------------------------------
        # ALMACENAMIENTO LOCAL
        # --------------------------------------------------

        try:
            metadata = self.storage.save(
                data=data,
                filename=filename,
                source_type=SourceType.TACHOGRAPH,
            )

        except Exception as exc:
            operation = Operation(
                operation_id=operation_id,
                operation_type=(
                    OperationType.TACHOGRAPH_DOWNLOAD
                ),
                timestamp=timestamp,
                source_type=SourceType.TACHOGRAPH,
                status=OperationStatus.FAILED,
                tachograph_id=tachograph_id,
                vehicle_id=vehicle_id,
                vehicle_registration=vehicle_registration,
                error_message=str(exc),
            )

            self._record(operation)

            return operation

        # --------------------------------------------------
        # SINCRONIZACIÓN
        # --------------------------------------------------

        sync_status = SyncStatus.LOCAL_ONLY

        if self.sync_service is not None:
            sync_status = self.sync_service.sync_file(
                metadata
            )

        # --------------------------------------------------
        # OPERACIÓN DE DESCARGA
        # --------------------------------------------------

        operation = Operation(
            operation_id=operation_id,
            operation_type=(
                OperationType.TACHOGRAPH_DOWNLOAD
            ),
            timestamp=timestamp,
            source_type=SourceType.TACHOGRAPH,
            status=OperationStatus.COMPLETED,
            tachograph_id=tachograph_id,
            vehicle_id=vehicle_id,
            vehicle_registration=vehicle_registration,
            file_id=metadata.file_id,
            sync_status=sync_status,
        )

        self._record(operation)

        return operation

    def _record(
        self,
        operation: Operation,
    ) -> None:
        """
        Registra la operación si existe un OperationLog.
        """

        if self.operation_log is not None:
            self.operation_log.append(operation)